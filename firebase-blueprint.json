{
  "entities": {
    "Mission": {
      "title": "Mission Record",
      "description": "Completed student job mission records",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentNickname": { "type": "string" },
        "studentAnimal": { "type": "string" },
        "missionType": { "type": "string", "enum": ["barista", "greeting"] },
        "missionTitle": { "type": "string" },
        "photoUrl": { "type": "string" },
        "feedback": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "in_progress"] },
        "timestamp": { "type": "number" }
      },
      "required": ["studentId", "studentNickname", "missionType", "missionTitle", "status", "timestamp"]
    },
    "Broadcast": {
      "title": "Teacher Broadcast Message",
      "description": "Celebratory broadcast sent by teacher",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["type", "message", "timestamp"]
    }
  },
  "firestore": {
    "/missions/{missionId}": {
      "schema": "Mission",
      "description": "Student mission records for classroom real-time leaderboard"
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Real-time celebratory notifications sent to all students"
    }
  }
}
